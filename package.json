{
  "name": "playwright-webext",
  "version": "0.1.0",
  "description": "A Playwright-powered testing harness for browser extensions",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "tsc": "tsc",
    "prettier": "prettier --check --ignore-unknown .",
    "prettier:w": "prettier --write --ignore-unknown .",
    "test": "echo tbd",
    "deps": "npx npm-check-updates -i --format group,dep,repo --cooldown 3",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@types/chrome": "^0.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20.19.43",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "printWidth": 100,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true
  },
  "keywords": [
    "playwright",
    "webextension",
    "chrome-extension",
    "testing",
    "manifest-v3"
  ],
  "funding": "https://github.com/sponsors/vitalets",
  "license": "MIT"
}
