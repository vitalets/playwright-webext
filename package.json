{
  "name": "playwright-webext",
  "version": "0.3.7",
  "description": "A Playwright-powered testing harness for browser extensions",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalets/playwright-webext.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "tsc": "tsc",
    "lint": "eslint .",
    "prettier": "prettier --check --ignore-unknown .",
    "prettier:w": "prettier --write --ignore-unknown .",
    "test": "npx playwright test --config test/playwright.config.ts",
    "sync:example": "npm --prefix example install . --no-save --package-lock=false --install-links --ignore-scripts",
    "test:example": "npm run build && npm run sync:example && npm --prefix example test",
    "deps": "npx npm-check-updates -i --interactiveSelect none --format group,dep,repo --cooldown 3",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "update:rules": "cp ../agentic-dev/rules/ts-file-structure/ts-file-structure.md .agents/rules/",
    "docs": "npm --prefix website run start --",
    "docs:build": "npm --prefix website run build",
    "docs:release": "git checkout docs && git pull --no-edit && git merge --no-edit main && git push origin docs && git checkout main",
    "docs:tsc": "npm --prefix website run typecheck"
  },
  "dependencies": {
    "@types/chrome": "^0.3.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-plugin-visual-complexity": "^0.1.4",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "singleQuote": true,
    "printWidth": 100,
    "semi": true,
    "trailingComma": "all",
    "bracketSpacing": true
  },
  "keywords": [
    "playwright",
    "webextension",
    "chrome-extension",
    "testing",
    "manifest-v3"
  ],
  "funding": "https://github.com/sponsors/vitalets",
  "license": "MIT"
}
